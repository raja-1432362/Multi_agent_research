# Copy to server/.env and fill in. NEVER commit server/.env
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/ai_research?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
GEMINI_API_KEY=
# Pick a Flash-class model that Google AI Studio shows as free for your project
GEMINI_MODEL=
TAVILY_API_KEY=
# Free-tier protection
MAX_RUNS_PER_DAY=5
MAX_SOURCES_CAP=15
# optional
FIRECRAWL_API_KEY=
